{
  "name": "k-sport",
  "private": true,
  "version": "2.0.15",
  "type": "module",
  "main": "electron.cjs",
  "author": "K-SPORT",
  "description": "Phần mềm quản lý giải đấu Karate - Bốc thăm tự động",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build:win": "npm run build && electron-builder --win --x64",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:all": "npm run build && electron-builder -mwl",
    "electron:build:dir": "npm run build && electron-builder --win --x64 --dir",
    "deploy-server": "scp license-server/server.js root@103.82.193.133:/root/karate-app/license-server/ && ssh root@103.82.193.133 \"pm2 restart all\"",
    "version": "node scripts/update-version-date.js && git add package.json",
    "rebuild-sqlite": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "better-sqlite3": "^9.6.0",
    "docx": "^9.7.1",
    "dom-to-image-more": "^3.7.2",
    "electron-updater": "^6.8.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.0.0",
    "lucide-react": "^1.14.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.2.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.karate.tournament.manager",
    "productName": "K-SPORT",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "quan2003",
        "repo": "Karate-Manager"
      }
    ],
    "files": [
      "dist/**/*",
      "electron.cjs",
      "licenseVault.cjs",
      "preload.cjs",
      "database.cjs",
      "public/**/*",
      "kata-scoreboard/**/*",
      "kumite-scoreboard/**/*",
      "node_modules/better-sqlite3/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "krt",
        "name": "K-SPORT File",
        "description": "File giải đấu Karate cho Huấn luyện viên",
        "role": "Editor"
      },
      {
        "ext": "kmatch",
        "name": "K-SPORT Match File",
        "description": "File chấm điểm Karate cho Thư ký",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "K-SPORT",
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.sports",
      "icon": "public/icon.png"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "buildDate": "28/07/2026"
}
