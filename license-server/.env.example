# Server Configuration
PORT=2000
NODE_ENV=production

# Security
JWT_SECRET=CHANGE_ME_USE_A_RANDOM_SECRET_WITH_AT_LEAST_64_CHARACTERS
# Optional server-to-server token for /api/public/*. Leave empty for a fully public read API.
PUBLIC_API_TOKEN=

# Cloudflare R2 private bucket for athlete card photos. Keep these server-only.
R2_ACCOUNT_ID=
R2_BUCKET=ksport-athletes
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Enables the rate-limited public registration-photo endpoints. Keep false
# until this server, the R2 CORS policy, and the public web environment are ready.
PUBLIC_REGISTRATION_UPLOADS_ENABLED=false

# Deployment helper (local only; never commit the real password)
KSPORT_VPS_HOST=103.82.193.133
KSPORT_VPS_USER=root
KSPORT_VPS_PASSWORD=
# JWT dùng để xác thực phiên đăng nhập Admin Web

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
WINDOW_MS=900000
MAX_REQUESTS=100

# PostgreSQL Configuration (New)
PG_USER=postgres
PG_HOST=localhost
PG_DATABASE=karate_license_db
PG_PASSWORD=CHANGE_ME_USE_A_STRONG_DATABASE_PASSWORD
PG_PORT=5432

# SMTP Email Notification (Gmail App Password)
SMTP_USER=luuquankarate@gmail.com
SMTP_PASS=CHANGE_ME_USE_A_GMAIL_APP_PASSWORD
