# Server Configuration
PORT=2000
NODE_ENV=production

# Security
JWT_SECRET=CHANGE_ME_USE_A_RANDOM_SECRET_WITH_AT_LEAST_64_CHARACTERS
# JWT dùng để xác thực phiên đăng nhập Admin Web

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
WINDOW_MS=900000
MAX_REQUESTS=100

# PostgreSQL Configuration (New)
PG_USER=postgres
PG_HOST=localhost
PG_DATABASE=karate_license_db
PG_PASSWORD=CHANGE_ME_USE_A_STRONG_DATABASE_PASSWORD
PG_PORT=5432

# SMTP Email Notification (Gmail App Password)
SMTP_USER=luuquankarate@gmail.com
SMTP_PASS=CHANGE_ME_USE_A_GMAIL_APP_PASSWORD
